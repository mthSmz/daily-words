{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/cron/route.js": {
      "maxDuration": 60
    },
    "app/api/poem/route.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "0 13 * * *" },
    { "path": "/api/poem", "schedule": "5 13 * * *" }
  ]
}
